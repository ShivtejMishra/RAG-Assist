# RAGAssist Environment Variables Example

# FastAPI Infrastructure
PORT=8000
HOST=0.0.0.0
DEBUG=true

# Security & Session Authentication
JWT_SECRET_KEY=super-secret-jwt-key-replace-in-production-with-secure-hash
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Atlas Credentials
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ragassist_enterprise

# Vector Store Credentials
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Redis Broker (for Celery Tasks)
REDIS_URL=redis://localhost:6379/0

# AWS S3 Storage (Optional: defaults to local disk storage if blank)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=us-east-1
